# EduSphere AI – Vercel / Local ENV
# Copy this file to .env and fill it with your Firebase web app config.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# --- WhatsApp (optional) ----------------------------------------------------
VITE_WHATSAPP_API_KEY=

# --- AI brain (v3.2: server-proxy first — keys NEVER ship in the bundle) ----
# The AI assistant now routes through the `aiChat` Firebase Cloud Function.
# Store your keys as SERVER-SIDE secrets (this is the only secure option):
#
#   cd functions
#   firebase functions:secrets:set GROQ_API_KEY
#   firebase functions:secrets:set GROQ_API_KEY_2     # optional 2nd key = double quota
#   firebase functions:secrets:set GEMINI_API_KEY     # optional, dormant
#   npm run deploy
#
# Failover chain: aiChat server proxy (Groq #1 → Groq #2 → Gemini) → local
# offline replies. Teachers never see a raw provider error.
#
# ⚠️ DEV / BYOK ONLY — the VITE_ variables below make the browser call Groq
# directly and BAKE THE KEY INTO THE PUBLIC JS BUNDLE. Anyone can extract it.
# Leave them unset in production; use the Cloud Function secrets instead.
#
# VITE_GROQ_API_KEY=
# VITE_GROQ_API_KEY_2=
# VITE_GROQ_MODEL=llama-3.3-70b-versatile
# VITE_GEMINI_API_KEY=        # dormant, AIza... only
# VITE_GEMINI_MODEL=gemini-2.0-flash
