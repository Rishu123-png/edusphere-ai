# EduSphere AI – Vercel / Local ENV
# Copy this file to .env and fill it with your Firebase web app config.
#
# ⚠️  SECURITY: every VITE_* variable is INLINED into the public JS bundle at
#     build time. Anyone can read them in DevTools on the deployed site — a
#     private GitHub repo does NOT protect them. Only put values here that are
#     safe to be public.

# --- Firebase web config (safe to be public) --------------------------------
# These are identifiers, not secrets. Your Realtime Database security rules
# (database.rules.json) are the actual access control boundary.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id


# ============================================================================
# AI keys are NOT configured here any more.
# ----------------------------------------------------------------------------
# The assistant calls the `aiChat` Cloud Function (functions/src/index.ts),
# which keeps the credential on the server. Configure it with:
#
#   # Option A — Google Gemini (default)
#   firebase functions:secrets:set GEMINI_API_KEY
#
#   # Option B — 100% free via OpenRouter (no credit card)
#   firebase functions:config:set ai.provider="openai"
#   firebase functions:secrets:set AI_API_KEY
#
# Optional server-side env vars:
#   AI_PROVIDER   'gemini' (default) | 'openai'
#   AI_BASE_URL   default https://openrouter.ai/api/v1
#   AI_MODEL      default meta-llama/llama-3.1-8b-instruct:free
#   GEMINI_MODEL  default gemini-2.0-flash
#
# If no key is configured the assistant still works — it falls back to the
# built-in offline replies in src/lib/gemini.ts.
# ============================================================================
