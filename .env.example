# EduSphere AI – Vercel / Local ENV
# Copy this file to .env and fill it with your Firebase web app config.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# --- WhatsApp (optional) ----------------------------------------------------
VITE_WHATSAPP_API_KEY=

# --- AI brain ---------------------------------------------------------------
# IMPORTANT: AI credentials are NEVER read from the browser bundle anymore.
# Every VITE_* variable is inlined into the public JS at build time, so any
# key placed here in the past was readable by anyone in DevTools/Network on
# the deployed site — regardless of whether this repo is public or private.
#
# The assistant now calls the `aiChat` Firebase Cloud Function
# (functions/src/index.ts), which holds the credential server-side.
# Configure it there, e.g.:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set GEMINI_MODEL   # optional, defaults to gemini-2.0-flash
#
# Nothing AI-related needs to be set in this file. If you want to develop
# the Cloud Function locally, put GEMINI_API_KEY in functions/.env instead
# (also git-ignored) and run `firebase emulators:start --only functions`.
