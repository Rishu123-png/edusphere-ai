{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'super_admin'",
      ".write": false,
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'super_admin' || (root.child('users').child(auth.uid).child('role').val() == 'school_admin' && data.child('schoolId').val() == root.child('users').child(auth.uid).child('schoolId').val()))",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'super_admin' || (root.child('users').child(auth.uid).child('role').val() == 'school_admin' && (data.child('schoolId').val() == root.child('users').child(auth.uid).child('schoolId').val() || newData.child('schoolId').val() == root.child('users').child(auth.uid).child('schoolId').val())))",
        ".validate": "newData.hasChildren(['uid','email','role','createdAt']) && (newData.child('role').val() == 'super_admin' || newData.child('role').val() == 'school_admin' || newData.child('role').val() == 'teacher' || newData.child('role').val() == 'student' || newData.child('role').val() == 'parent') && (auth.uid != $uid || (newData.child('role').val() != 'super_admin' && (!data.child('schoolId').exists() || (newData.child('role').val() == data.child('role').val() && (!newData.hasChildren(['schoolId']) || newData.child('schoolId').val() == data.child('schoolId').val())))))"
      }
    },

    "schoolCodes": {
      ".read": "auth != null",
      ".indexOn": ["code"],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('createdBy').val() == auth.uid || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
        ".validate": "newData.hasChildren(['schoolId','code','createdBy','createdAt'])"
      }
    },

    "schools": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'super_admin'",
      ".write": false,
      ".indexOn": ["code"],
      "$schoolId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'super_admin' || (root.child('users').child(auth.uid).child('role').val() == 'school_admin' && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId) || (!data.exists() && newData.child('createdBy').val() == auth.uid))",

        "branding": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          ".write": "auth != null && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && (root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
        },

        "students": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          ".indexOn": ["className", "guardianEmail", "parentUid"],
          "$studentId": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && (root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
            ".validate": "newData.hasChildren(['name','rollNumber','className','schoolId'])"
          }
        },

        "teachers": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          "$teacherId": {
            ".write": "auth != null && ((root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && (root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')) || (auth.uid == $teacherId && newData.child('schoolId').val() == $schoolId))"
          }
        },

        "attendance": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          ".indexOn": [".key"],
          "$date": {
            // WRITE RULE AT $DATE LEVEL — cascades to EVERY descendant path below.
            // This covers BOTH shapes:
            //   legacy flat:  attendance/$date/$studentId              (record)
            //   new nested:   attendance/$date/$classKey/$slotKey/$studentId  (record)
            // Firebase RTDB .write rules cascade down, so granting write at $date
            // grants write for all children/grandchildren — no need for per-level
            // write rules. The earlier "two sibling $wildcards" parse error came
            // from trying to split writes by path name; cascading avoids it entirely.
            ".write": "auth != null && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && (root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",

            // VALIDATION: any node written that HAS a 'studentId' field is an
            // attendance record and must have all required fields. Internal
            // wrapper nodes (like 10-A, morning, p0:0800) don't have studentId,
            // so they pass without triggering the record check.
            ".validate": "(!newData.exists()) || (!newData.hasChildren(['studentId'])) || (newData.hasChildren(['studentId','date','status','markedBy','timestamp']) && (newData.child('status').val() == 'present' || newData.child('status').val() == 'late' || newData.child('status').val() == 'absent' || newData.child('status').val() == 'leave'))",

            "$any": {
              // Apply the same "is-a-record?" validation at every descendant level.
              // Wrapper nodes (classKey/slotKey) don't have studentId → pass.
              // Record nodes (leaf) DO have studentId → must satisfy the check.
              ".validate": "(!newData.exists()) || (!newData.hasChildren(['studentId'])) || (newData.hasChildren(['studentId','date','status','markedBy','timestamp']) && (newData.child('status').val() == 'present' || newData.child('status').val() == 'late' || newData.child('status').val() == 'absent' || newData.child('status').val() == 'leave'))",

              "$any2": {
                ".validate": "(!newData.exists()) || (!newData.hasChildren(['studentId'])) || (newData.hasChildren(['studentId','date','status','markedBy','timestamp']) && (newData.child('status').val() == 'present' || newData.child('status').val() == 'late' || newData.child('status').val() == 'absent' || newData.child('status').val() == 'leave'))",

                "$any3": {
                  ".validate": "(!newData.exists()) || (!newData.hasChildren(['studentId'])) || (newData.hasChildren(['studentId','date','status','markedBy','timestamp']) && (newData.child('status').val() == 'present' || newData.child('status').val() == 'late' || newData.child('status').val() == 'absent' || newData.child('status').val() == 'leave'))"
                }
              }
            }
          }
        },

        "marks": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          "$studentId": {
            ".indexOn": ["subject", "examType"],
            "$markId": {
              ".write": "auth != null && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && (root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
              ".validate": "newData.hasChildren(['id','schoolId','studentId','subject','examType','marksObtained','maxMarks','enteredBy','date','createdAt']) && newData.child('schoolId').val() == $schoolId && newData.child('studentId').val() == $studentId && newData.child('marksObtained').isNumber() && newData.child('maxMarks').isNumber() && newData.child('maxMarks').val() >= 5 && newData.child('maxMarks').val() <= 300 && newData.child('marksObtained').val() >= 0 && newData.child('marksObtained').val() <= newData.child('maxMarks').val() && newData.child('subject').isString() && newData.child('examType').isString() && newData.child('date').isString() && newData.child('enteredBy').isString()"
            }
          }
        },

        "schedule": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          ".write": "auth != null && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && (root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
        },

        "schedules": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          ".write": "auth != null && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && (root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
        },

        "events": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          ".indexOn": ["date", "type"],
          "$eventId": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && (root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
            ".validate": "newData.hasChildren(['id','title','date','type','createdAt'])"
          }
        },

        "notifications": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('schoolId').val() == $schoolId || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
          ".indexOn": ["createdAt", "type"],
          "$notificationId": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('schoolId').val() == $schoolId && ((root.child('users').child(auth.uid).child('role').val() == 'teacher' || root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin') || (newData.child('read').val() == true && data.child('title').val() == newData.child('title').val() && data.child('body').val() == newData.child('body').val() && data.child('type').val() == newData.child('type').val()))"
          }
        }
      }
    },

    "logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'super_admin'",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'super_admin' || root.child('users').child(auth.uid).child('role').val() == 'school_admin')",
      "$logId": {
        ".validate": "newData.hasChildren(['uid','action','timestamp'])"
      }
    },

    "invites": {
      ".read": false,
      "$code": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'school_admin' || root.child('users').child(auth.uid).child('role').val() == 'super_admin')"
      }
    }
  }
}
