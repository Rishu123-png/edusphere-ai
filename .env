# EduSphere AI — local environment
# Copy of .env.example. This file is git-ignored and must never contain a
# real secret once you commit — see SECURITY.md for the incident this repo
# had (two live keys were committed on `main`).
#
# AI calls now go through the `aiChat` Firebase Cloud Function
# (functions/src/index.ts), which holds the Gemini API key server-side.
# The browser client (src/lib/gemini.ts) no longer reads or needs any
# VITE_AI_*/VITE_GEMINI_* key — nothing AI-related belongs in this file
# anymore. Configure the server-side key with:
#   firebase functions:secrets:set GEMINI_API_KEY
#
# Fill in your own Firebase web app config below.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
