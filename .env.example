# EduSphere AI – Vercel / Local ENV
# Copy this file to .env and fill it with your Firebase web app config.

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# --- WhatsApp (optional) ----------------------------------------------------
VITE_WHATSAPP_API_KEY=

# --- AI brain (client-side, v3.1 dual-Groq-key failover) --------------------
# v3.1 uses TWO Groq API keys for redundancy (primary + fallback). Gemini is
# dormant until you provide a real AIza... key from aistudio.google.com.
#
# Failover chain: Groq #1 → Groq #2 → local offline replies.
# If one key hits quota / fails / times out, the client silently retries on
# the other key — the teacher never sees an error.
#
# Inline defaults in src/lib/gemini.ts already contain the first Groq key, so
# AI works out of the box on Vercel. Add a 2nd key here or in Vercel settings
# for double quota (create a 2nd free Groq account to double free-tier limits).
#
# VITE_GROQ_API_KEY=
# VITE_GROQ_API_KEY_2=
# VITE_GROQ_MODEL=llama-3.3-70b-specdec
# VITE_GEMINI_API_KEY=        # dormant, AIza... only
# VITE_GEMINI_MODEL=gemini-2.0-flash
#
# Server-side keys (post-pilot hardening):
#   cd functions && firebase functions:secrets:set GROQ_API_KEY
#   cd functions && firebase functions:secrets:set GROQ_API_KEY_2
# Then: npm run deploy  (inside functions/)
# The cloud function mirrors the same Groq #1 → Groq #2 → Gemini failover chain.
